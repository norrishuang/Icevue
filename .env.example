# Start with the built-in catalog to evaluate the complete UI.
ICEVUE_DEMO_MODE=true
ICEVUE_CATALOG_CONFIG=/app/config/catalogs.yaml

# Legacy single-catalog settings are imported only when the configuration file
# does not exist. New connections can be managed in the Icevue UI.
ICEVUE_CATALOG_NAME=production
ICEVUE_CATALOG_URI=http://iceberg-rest:8181
ICEVUE_CATALOG_WAREHOUSE=s3://my-warehouse/

# Use either a bearer token or an OAuth2 credential, depending on the catalog.
# ICEVUE_CATALOG_TOKEN=
# ICEVUE_CATALOG_CREDENTIAL=client-id:client-secret
# ICEVUE_CATALOG_OAUTH2_SERVER_URI=https://identity.example.com/oauth2/token
# ICEVUE_CATALOG_SCOPE=catalog
# ICEVUE_CATALOG_PREFIX=

# Additional PyIceberg properties as a JSON object. These are passed to
# pyiceberg.catalog.load_catalog and can include object-store configuration.
# ICEVUE_CATALOG_PROPERTIES={"s3.region":"us-east-1"}

# AWS credentials for SigV4 catalogs such as Amazon S3 Tables should normally
# come from an IAM role. Local Docker can use the standard AWS environment
# variables or a mounted AWS profile.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Request limits.
# ICEVUE_MAX_PARTITION_PAGE_SIZE=250
